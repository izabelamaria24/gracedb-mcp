# GraceDB service instance. Use the playground for testing without touching production.
#   Production: https://gracedb.ligo.org/api/
#   Playground: https://gracedb-playground.ligo.org/api/
GRACEDB_SERVICE_URL=https://gracedb.ligo.org/api/

# Anonymous access is enough for PUBLIC superevents. Set this to force it.
GRACEDB_FORCE_NOAUTH=true

# Authenticated access (LVK members) — provide EITHER a proxy OR a cert/key pair.
# GRACEDB_PROXY=/path/to/x509_proxy
# GRACEDB_CERT=/path/to/robot.cert.pem
# GRACEDB_KEY=/path/to/robot.key.pem

# Where downloaded artifacts and strain files are written (default ~/.cache/gracedb-mcp).
GRACEDB_MCP_DATA_DIR=./data
